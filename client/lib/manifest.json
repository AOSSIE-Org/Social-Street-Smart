{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "Social Street Smart (AGNI AI)",
  "description": "Unstoppable AI that runs locally in your browser.",
  "default_locale": "en",
  "background": {
    "service_worker": "scripts/background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": "assets/icon/pop.png",
    "default_title": "Social Street Smart",
    "default_popup": "views/popup.html"
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "offscreen" 
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [ "common/*.json", "assets/*", "offscreen.html" ],
      "matches": [ "<all_urls>" ]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content/sss.js"],
      "run_at": "document_end"
    }
  ]
}
